{
  "name": "aileena-computer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Owner small computer: Cloudflare worker-shell + official computerd container. Not inside aileena-new.",
  "scripts": {
    "predev": "docker build -t aileena-redirect-proxy:local -f sidecar/Dockerfile sidecar",
    "dev": "bash ./scripts/dev.sh",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "smoke": "node ./scripts/smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/computer": "0.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260616.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.107.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
