# Official DeepSeek API key from https://platform.deepseek.com
# Never commit the real value. This client does not add a daily cap;
# DeepSeek account balance and DeepSeek rate limits still apply.
DEEPSEEK_API_KEY=sk-your-key-here

# Optional. Default is the official OpenAI-compatible endpoint.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. Allowed: deepseek-v4-flash (default) | deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash

# Optional. enabled | disabled (default disabled)
# DEEPSEEK_THINKING=disabled
