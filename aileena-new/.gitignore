# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# package manager — this project uses pnpm; reject stray npm lockfiles
package-lock.json

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# Owner computer prototype workspace (local shim; never commit)
.data/computer-prototype/

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated by scripts/build-article-index.ts at build time
lib/agentArticleIndex.json
lib/memoryIndex.json

# Generated by scripts/build-data-index.ts at build time
lib/dataDocIndex.json

# verify-dj-set workflow output
.verify-screenshots/
.verify-memory/
data/pricing.json
data/news.json
data/inkling-clips/
