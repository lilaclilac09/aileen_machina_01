# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only: never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required for POST /api/add-from-x (admin publish)
NEON_ARCHIVE_ADMIN_SECRET=generate-a-long-random-string

# Resend — contact form / leave-a-note / chat transcript forward
# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Required: real owner inbox (NOT cafe@aileena.xyz — that address is From-only)
CONTACT_TO=you@example.com
# Aliases also accepted: CONTACT_TO_EMAIL | LEAD_INBOX | NOTIFY_CC_EMAIL
# Optional From (defaults to AILEENA MACHINA <cafe@aileena.xyz> — must be verified domain)
# RESEND_FROM=AILEENA MACHINA <cafe@aileena.xyz>
# FROM_EMAIL= / CONTACT_FROM= / CONTACT_FROM_EMAIL=

# ─── Aileena Console (site agent at /api/chat) ────────────────────────────────
# Pick ONE provider. Priority order: GROQ_API_KEY > AGENT_BASE_URL > ANTHROPIC_API_KEY.
#
# 1. Groq — recommended default. Free tier is 14,400 req/day, ~500 tok/s.
#    Get a key at https://console.groq.com → API Keys.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — defaults to llama-3.3-70b-versatile. See https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile
#
# 2. Self-hosted (Ollama / vLLM / llama.cpp / LM Studio behind a tunnel).
#    Must be a PUBLIC https url reachable from Vercel, not localhost.
# AGENT_BASE_URL=https://your-tunnel.example.com/v1
# AGENT_API_KEY=optional-if-the-endpoint-requires-one
# AGENT_MODEL=qwen2.5:14b
#
# 3. Anthropic — Claude Sonnet 4.6 (paid, highest quality). Get key at
#    https://console.anthropic.com → API Keys.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Optional: HMAC-sign the per-visitor daily quota cookie so it can't be tampered
# with client-side. Without it the limit still works, just isn't tamper-proof.
# CHAT_QUOTA_SECRET=generate-a-long-random-string

# Server-only AES-256-GCM key for private transcripts at rest (Redis chat forwards).
# Production: 32 random bytes, base64 — `openssl rand -base64 32`
# Never expose to the client. If missing, Redis will not store plaintext transcripts
# (email forward can still send). Council chat is session-only and is not persisted.
# PRIVATE_DATA_ENCRYPTION_KEY=
