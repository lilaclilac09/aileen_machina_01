# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only: never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required for POST /api/add-from-x (admin publish)
NEON_ARCHIVE_ADMIN_SECRET=generate-a-long-random-string

# Resend — contact form / leave-a-note / chat transcript forward
# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Required: real owner inbox (NOT cafe@aileena.xyz — that address is From-only)
CONTACT_TO=you@example.com
# Aliases also accepted: CONTACT_TO_EMAIL | LEAD_INBOX | NOTIFY_CC_EMAIL
# Owner chat unlock — OWNER_EMAILS only. No email is hardcoded.
# Contact inbox env (CONTACT_TO / aliases) does not unlock owner chat.
# Comma / space / semicolon-separated. Empty / unset → email unlock is always false.
# OWNER_EMAILS=you@example.com
# Optional From (defaults to AILEENA MACHINA <cafe@aileena.xyz> — must be verified domain)
# RESEND_FROM=AILEENA MACHINA <cafe@aileena.xyz>
# FROM_EMAIL= / CONTACT_FROM= / CONTACT_FROM_EMAIL=

# ─── Aileena Console (site agent at /api/chat) ────────────────────────────────
# Pick ONE provider. Priority order: GROQ_API_KEY > AGENT_BASE_URL > ANTHROPIC_API_KEY.
#
# 1. Groq — recommended default. Free tier is 14,400 req/day, ~500 tok/s.
#    Get a key at https://console.groq.com → API Keys.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — defaults to llama-3.3-70b-versatile. See https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile
#
# 2. Self-hosted (Ollama / vLLM / llama.cpp / LM Studio behind a tunnel).
#    Must be a PUBLIC https url reachable from Vercel, not localhost.
# AGENT_BASE_URL=https://your-tunnel.example.com/v1
# AGENT_API_KEY=optional-if-the-endpoint-requires-one
# AGENT_MODEL=qwen2.5:14b
#
# 3. Anthropic — Claude Sonnet 4.6 (paid, highest quality). Get key at
#    https://console.anthropic.com → API Keys.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Optional: HMAC-sign the per-visitor daily quota cookie so it can't be tampered
# with client-side. Without it the limit still works, just isn't tamper-proof.
# CHAT_QUOTA_SECRET=generate-a-long-random-string

# Owner key — /api/auth/owner and local `pnpm council` (CLI is not on the public site)
# OWNER_KEY=generate-a-long-random-string
#
# Computer workspace prototype (owner-only, never production).
# Hard-disabled when VERCEL_ENV=production. Preview needs COMPUTER_PROTOTYPE=1.
# Local `pnpm dev` is on by default. Do not point this at Cloudflare Computer yet.
# COMPUTER_PROTOTYPE=1
# Local-only owner enter for /proof (never production).
# ALLOW_EXPERIMENT_UNLOCK=1
# Council CLI also needs DEEPSEEK_API_KEY or AGENT_API_KEY. Never commit this file.

# Spotify search on /sound — server-only Client Credentials.
# Adds reference/preview cards to the existing carousel. Does NOT enable
# mix / record / export of Spotify audio through Web Audio.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Server-only AES-256-GCM key for private transcripts at rest (Redis chat forwards).
# Production: 32 random bytes, base64 — `openssl rand -base64 32`
# Never expose to the client. If missing, Redis will not store plaintext transcripts
# (email forward can still send). Council chat is session-only and is not persisted.
# PRIVATE_DATA_ENCRYPTION_KEY=

# Site-agent TTS (server-only). Same profile on every chunk. Do not put keys in NEXT_PUBLIC_*.
# ELEVENLABS_API_KEY=  or  OPENAI_API_KEY=
# Optional pins (otherwise Console city accent: shanghai / london / berlin):
# SITE_AGENT_TTS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# SITE_AGENT_TTS_STYLE=0.14
# SITE_AGENT_TTS_ACCENT=shanghai
# SITE_AGENT_TTS_SPEED=0.9

# Owner Cloudflare Computer (local / Vercel Preview only). Never on Production.
# Worker: workers/aileena-computer  (pnpm dev → http://127.0.0.1:8787)
# COMPUTER_PROTOTYPE=1
# COMPUTER_WORKER_URL=http://127.0.0.1:8787
# COMPUTER_WORKER_SECRET=dev-aileena-computer-local

