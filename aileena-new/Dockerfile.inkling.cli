# Slim CLI-only image: yt-dlp + ffmpeg + pnpm inkling:clips
# No Next.js build — smaller than Dockerfile.inkling (Browser Run).
#
# Build (on a machine with disk, or in CI/cloud):
#   docker build -f Dockerfile.inkling.cli -t aileena-clips-cli .
#
# Free local (no API key):
#   docker run --rm -v "$PWD/out:/out" aileena-clips-cli \
#     -- 'https://www.youtube.com/watch?v=jNQXAC9IVRw' --local --best 2 --dry-run --work-dir /out/job1

FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3 \
    python3-pip \
    ca-certificates \
    curl \
  && pip3 install --break-system-packages --no-cache-dir yt-dlp \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.33.3 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Only what the CLI pipeline needs
COPY scripts/inkling-clips.ts scripts/inkling-clips.ts
COPY lib/inkling lib/inkling
COPY tsconfig.json tsconfig.json

ENV NODE_ENV=production
WORKDIR /out

ENTRYPOINT ["pnpm", "--dir", "/app", "exec", "tsx", "/app/scripts/inkling-clips.ts"]
